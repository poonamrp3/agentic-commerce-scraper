# --- 1. PROXY CONFIGURATION ---
# Put your Residential Proxy URL here (e.g., BrightData, Oxylabs)
PROXY_URL=http://username:password@pr.oxylabs.io:7777

# --- 2. LLM CONFIGURATION ---
# The primary LLM used by the Agents.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# (Optional) If you are using a local OpenAI-compatible proxy, uncomment this:
# OPENAI_BASE_URL=http://localhost:4981/openai/v1
